{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Produs",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "size": {
      "type": "string"
    },
    "stock": {
      "type": "integer"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "products"
    },
    "color": {
      "type": "string"
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "brand": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "slug": {
      "type": "string",
      "unique": true
    },
    "warranty_months": {
      "type": "integer"
    },
    "rating": {
      "type": "decimal"
    },
    "weight": {
      "type": "decimal"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
