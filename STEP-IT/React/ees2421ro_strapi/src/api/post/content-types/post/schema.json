{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "post"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title_ro": {
      "type": "string",
      "required": true
    },
    "title_ru": {
      "type": "string",
      "required": true
    },
    "title_en": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title_ro",
      "required": true
    },
    "description_ro": {
      "type": "richtext",
      "required": true
    },
    "description_ru": {
      "type": "richtext",
      "required": true
    },
    "description_en": {
      "type": "richtext",
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::category.category",
      "inversedBy": "posts"
    },
    "author": {
      "type": "string"
    },
    "published_date": {
      "type": "date"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    }
  }
}
